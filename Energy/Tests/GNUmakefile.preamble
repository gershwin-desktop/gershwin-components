GNUSTEP_INSTALLATION_DOMAIN = SYSTEM

# The units under test live in libEnergyBackend (ARC); the test tool stays
# MRC because the ObjectTesting macros retain and release explicitly, so it
# links the library built in this tree instead of compiling its sources.
ADDITIONAL_INCLUDE_DIRS += -I.. -I../..
ADDITIONAL_OBJCFLAGS += -Wall -Wextra -Werror

EB_LIBDIR = $(CURDIR)/../../Libraries/EnergyBackend/obj
# gnustep-make puts the installed library directory ahead of
# ADDITIONAL_LIB_DIRS, so an installed older libEnergyBackend would win; the
# flags here come first.  GNUstep.sh puts the installed libraries on
# LD_LIBRARY_PATH, which beats a DT_RUNPATH but not a DT_RPATH, so the old
# tag keeps the test on this tree at run time too.
ADDITIONAL_LDFLAGS += -L$(EB_LIBDIR) -Wl,--disable-new-dtags -Wl,-rpath,$(EB_LIBDIR)
ADDITIONAL_TOOL_LIBS += -lEnergyBackend
