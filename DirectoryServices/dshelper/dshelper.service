[Unit]
Description=Gershwin Directory Services Helper (directory server)
After=network.target gdomap.service
Wants=gdomap.service
# Only a directory server needs dshelper; nss_gershwin resolves users
# without it. dscli promote enables this unit, dscli demote disables it.
ConditionPathExists=/Local/Library/DirectoryServices/Domain.plist

[Service]
Type=forking
ExecStart=/bin/sh -c '. /System/Library/Makefiles/GNUstep.sh && /System/Library/Tools/dshelper'
PIDFile=/var/run/dshelper.pid
Restart=on-failure

[Install]
WantedBy=multi-user.target
