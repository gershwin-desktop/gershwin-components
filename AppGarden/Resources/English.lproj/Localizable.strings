/* Catalog errors shown in an alert when the feed cannot be used. */
"The catalog is not valid JSON." = "The catalog is not valid JSON.";
"The catalog is not a JSON object." = "The catalog is not a JSON object.";
"The catalog has no \"items\" list." = "The catalog has no \"items\" list.";
"The catalog's \"items\" entry is not a list." = "The catalog's \"items\" entry is not a list.";

/* -------------------------------------------------- Services: catalog */

/* Catalog fetch failures, shown in the status banner next to the cached
 * catalog, or in the error view when there is no cache at all. %@ carries
 * curl's first stderr line. */
"Could not download the catalog: %@" = "Could not download the catalog: %@";
"The catalog download produced no data." = "The catalog download produced no data.";
"The catalog cache could not be read." = "The catalog cache could not be read.";
"Could not save the catalog: %@" = "Could not save the catalog: %@";

/* Image fetch failures. The caller draws the placeholder icon and keeps
 * these as a tooltip; %@ carries curl's first stderr line. */
"Could not download the image: %@" = "Could not download the image: %@";
"Could not download the image: no data arrived." = "Could not download the image: no data arrived.";
"Not an image" = "Not an image";
"No image URL was given." = "No image URL was given.";
"This image failed to load earlier in this session." = "This image failed to load earlier in this session.";

/* ------------------------------------------------ Services: downloading */

/* Removal and launch failures, shown in an alert. The first %@ is the
 * application's display name, the second the underlying reason. */
"Could not remove %@: %@" = "Could not remove %@: %@";
"Could not start %@: %@" = "Could not start %@: %@";

/* A GitHub API failure that was a rate limit: the downloader's own message
 * names only the step that failed, so the rewrite in AGInstallTask prefixes
 * it. %@ is that original message. */
"GitHub rate limit reached: %@" = "GitHub rate limit reached: %@";

/* -------------------------------------------------------------- Views */

/* Grid page states (AGAppGridView). %@ is the search query. */
"Loading catalog..." = "Loading catalog...";
"No applications match \"%@\"." = "No applications match \"%@\".";
"You have not downloaded anything yet. Apps you get from AppGarden appear here." = "You have not downloaded anything yet. Apps you get from AppGarden appear here.";

/* Download button titles, one per state (AGInstallButton). */
"Get" = "Get";
"Waiting..." = "Waiting...";
"Open" = "Open";
"Failed" = "Failed";
"Open Page" = "Open Page";
"Unavailable" = "Unavailable";
"Downloading. Click to cancel." = "Downloading. Click to cancel.";

/* Download alerts and the failed-state tooltip fallback. */
"Download Failed" = "Download Failed";
"The download failed." = "The download failed.";
"Try Again" = "Try Again";
"Cancel" = "Cancel";
"OK" = "OK";
"Could Not Open the Application" = "Could Not Open the Application";

/* Screenshot frame fallback when the picture does not arrive (AGScreenshotView). */
"Screenshot unavailable" = "Screenshot unavailable";

