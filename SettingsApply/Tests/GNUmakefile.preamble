GNUSTEP_INSTALLATION_DOMAIN = SYSTEM

# The units under test are ARC; the test tool stays MRC because the
# ObjectTesting macros retain and release explicitly.
SA_ARCFLAGS = -fobjc-arc -fobjc-arc-exceptions
SA_SOURCES = ../SASetting.m ../SASettingsRegistry.m ../SASettingsApplier.m
$(foreach f,$(SA_SOURCES),$(eval $(f)_FILE_FLAGS += $(SA_ARCFLAGS)))
t_SettingsRegistry_OBJC_FILES += $(SA_SOURCES)

ADDITIONAL_INCLUDE_DIRS += -I.. -I../../Mouse -I../../Keyboard -I../../Energy -I../../Color
ADDITIONAL_OBJCFLAGS += -Wall -Wextra -Werror

# The applier links every pane backend; the build-tree libraries win over
# anything installed, so the test checks the code in this tree.
SA_LIBDIRS = MouseBackend KeyboardBackend EnergyBackend CPUGovernorBackend ColorProfileBackend
ADDITIONAL_LIB_DIRS += $(foreach l,$(SA_LIBDIRS),-L$(CURDIR)/../../Libraries/$(l)/obj)
ADDITIONAL_LDFLAGS += -Wl,--disable-new-dtags \
	$(foreach l,$(SA_LIBDIRS),-Wl,-rpath,$(CURDIR)/../../Libraries/$(l)/obj)
t_SettingsRegistry_TOOL_LIBS += -lMouseBackend -lKeyboardBackend -lEnergyBackend \
	-lCPUGovernorBackend -lColorProfileBackend
