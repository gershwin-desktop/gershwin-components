ADDITIONAL_INCLUDE_DIRS += -I../../Models -I../../Controllers

# SWGitTool resolves the privilege-escalation command through PackageManager's
# GWSudoHelper, so every test tool that links it needs the framework too -
# like t_SWPrerequisitesInstaller, which uses the framework directly.
PACKAGE_MANAGER_LIBS = \
  -L/System/Library/Frameworks/PackageManager.framework/Versions/1 -lPackageManager

ARCFLAGS = -fobjc-arc -fobjc-arc-exceptions
../../Models/SWRepository.m_FILE_FLAGS += $(ARCFLAGS)
../../Models/SWRepositoryList.m_FILE_FLAGS += $(ARCFLAGS)
../../Models/SWGitTool.m_FILE_FLAGS += $(ARCFLAGS)
../../Models/SWSelectionRules.m_FILE_FLAGS += $(ARCFLAGS)
../../Models/SWGitHubBuildStatus.m_FILE_FLAGS += $(ARCFLAGS)
../../Models/SWUpdateChecker.m_FILE_FLAGS += $(ARCFLAGS)
../../Models/SWRepositoryUpdater.m_FILE_FLAGS += $(ARCFLAGS)

t_SWRepositoryList_OBJC_FILES += \
  ../../Models/SWRepository.m \
  ../../Models/SWRepositoryList.m

t_SWGitTool_OBJC_FILES += \
  ../../Models/SWGitTool.m
t_SWGitTool_TOOL_LIBS += $(PACKAGE_MANAGER_LIBS)

t_SWSelectionRules_OBJC_FILES += \
  ../../Models/SWRepository.m \
  ../../Models/SWSelectionRules.m

t_SWGitHubBuildStatus_OBJC_FILES += \
  ../../Models/SWGitHubBuildStatus.m
t_SWGitHubBuildStatus_TOOL_LIBS += -lgnustep-base

t_SWUpdateChecker_OBJC_FILES += \
  ../../Models/SWRepository.m \
  ../../Models/SWRepositoryList.m \
  ../../Models/SWGitTool.m \
  ../../Models/SWGitHubBuildStatus.m \
  ../../Models/SWSelectionRules.m \
  ../../Models/SWUpdateChecker.m
# The parallel check uses dispatch_group/dispatch_semaphore.
t_SWUpdateChecker_TOOL_LIBS += -ldispatch
t_SWUpdateChecker_TOOL_LIBS += $(PACKAGE_MANAGER_LIBS)

t_SWRepositoryUpdater_OBJC_FILES += \
  ../../Models/SWRepository.m \
  ../../Models/SWGitTool.m \
  ../../Models/SWRepositoryUpdater.m
# The streaming-output case drives a real long-running child from a background
# queue while the main thread watches the log.
t_SWRepositoryUpdater_TOOL_LIBS += -ldispatch
t_SWRepositoryUpdater_TOOL_LIBS += $(PACKAGE_MANAGER_LIBS)

# Foundation only on purpose: the point of SWCompletionSummary is that the
# completion window's wording can be tested with no window server, so this
# tool must not pull AppKit in.
../../Models/SWCompletionSummary.m_FILE_FLAGS += $(ARCFLAGS)
t_SWCompletionSummary_OBJC_FILES += t_SWCompletionSummary.m \
  ../../Models/SWCompletionSummary.m

# Same reason: the outcome-to-status mapping is a static inline in the header,
# so this needs nothing but Foundation.
t_SWProgressPhase_OBJC_FILES += t_SWProgressPhase.m \
  ../../Controllers/SWProgressPhase.m

../../Models/SWPrerequisitesInstaller.m_FILE_FLAGS += $(ARCFLAGS)
t_SWPrerequisitesInstaller_OBJC_FILES += \
  ../../Models/SWPrerequisitesInstaller.m
# Needs PackageManager (installed system-wide by gmake install in
# PackageManager/) for GWPackageManager/GWOSDetector.
t_SWPrerequisitesInstaller_TOOL_LIBS += $(PACKAGE_MANAGER_LIBS)
ADDITIONAL_LDFLAGS += -Wl,-rpath,/System/Library/Frameworks/PackageManager.framework/Versions/1

# The run guard shells out to ps and reads no display, so Foundation only.
../../Models/SWRunGuard.m_FILE_FLAGS += $(ARCFLAGS)
t_SWRunGuard_OBJC_FILES += t_SWRunGuard.m \
  ../../Models/SWRunGuard.m
