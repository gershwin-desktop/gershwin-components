#!/usr/bin/env run_uitest
# Player shows the picture of a video file in place of the cover art, and
# full screen covers the screen and comes back to the same window frame
# with Escape.
#
# Leaves the computer as it was found: the fixture is removed and the app is
# quit at the end.
#
# Run with: run_uitest Player/Tests/player_video.uitest
# Player reopens in Internet radio mode if it was quit in it
shell "defaults delete io.github.gershwin-desktop.Player PlayerMode >/dev/null 2>&1; true"
shell "rm -rf /tmp/player-uitest-${home} && mkdir -p /tmp/player-uitest-${home} && ffmpeg -loglevel error -f lavfi -i testsrc=duration=30:size=320x240:rate=25 -f lavfi -i sine=duration=30 -c:v mpeg4 -c:a aac -shortest -metadata title='Test Clip' /tmp/player-uitest-${home}/clip.mp4"
shell "openapp Player /tmp/player-uitest-${home}/clip.mp4 >/dev/null 2>&1 &"
wait 2s
activate application "Player"
wait until window "Player - Test Clip" timeout 15s
wait until button "Pause" timeout 5s
# The picture replaces the cover art
shell "sleep 1; /System/Library/Tools/drive_ui --pid $(pgrep -u $(id -u) -x Player) find_widgets --class ItemFlowView | cut -f7 | grep -qx 1"
shell "/System/Library/Tools/drive_ui --pid $(pgrep -u $(id -u) -x Player) find_widgets --class VideoRenderView | grep -q VideoRenderView"

assert window "Player - Test Clip" frame constant
select menu "View/Enter Full Screen"
wait until not exists button "Open..." timeout 5s
assert menu item "View/Exit Full Screen"
press key "Escape"
wait until button "Open..." timeout 5s
assert menu item "View/Enter Full Screen"
assert window "Player - Test Clip" frame constant

activate application "Player"
wait until menu bar "Player" timeout 10s
press "Alt+Q"
wait until not exists window "Player - Test Clip" timeout 5s
# Sound fades out for a second before the app goes
wait until not exists application "Player" timeout 5s
shell "rm -rf /tmp/player-uitest-${home}"
log "Player shows video and returns from full screen"
