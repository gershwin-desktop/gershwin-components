#
# Settings for Player's unit tests.  gnustep-tests regenerates GNUmakefile
# on every run, so everything a tool needs beyond its own t_*.m lives here.
# Run them with "gnustep-tests --sequential ." (the tools share sources).
# t_PlayerMenu and t_PlayerViews need a DISPLAY.
#
GNUSTEP_INSTALLATION_DOMAIN = SYSTEM

ADDITIONAL_INCLUDE_DIRS += -I../.. -I../../../MediaRemote -ISupport
# GSDisplayServer.h declares methods without a return type
ADDITIONAL_OBJCFLAGS += -Wno-deprecated -Wall -Wextra -Werror -Wno-missing-method-return-type \
	-Wno-unused-parameter

# StreamPlayer decodes with FFmpeg and plays through libao
FFMPEG_PKGS = libavformat libavcodec libavutil libswresample libswscale
ADDITIONAL_INCLUDE_DIRS += $(shell pkg-config --cflags $(FFMPEG_PKGS))
FFMPEG_LIBS = $(shell pkg-config --libs $(FFMPEG_PKGS) ao)

t_PlayerPlaybackMachine_OBJC_FILES += ../../PlayerPlaylist.m
t_PlayerSession_OBJC_FILES += ../../PlayerPlaylist.m ../../PlayerAsync.m \
	../../PlayerPlaybackMachine.m
t_PlayerSessionMedia_OBJC_FILES += Support/TestMedia.m ../../PlayerSession.m \
	../../PlayerPlaybackMachine.m \
	../../PlayerPlaylist.m ../../StreamPlayer.m ../../PlayerAsync.m
t_PlayerSessionMedia_TOOL_LIBS += $(FFMPEG_LIBS)
t_PlayerMenu_OBJC_FILES += ../../PlayerMenu.m
t_PlayerMenu_TOOL_LIBS += -lgnustep-gui
t_PlayerViews_OBJC_FILES += ../../PlayerViews.m
t_PlayerViews_TOOL_LIBS += -lgnustep-gui $(shell pkg-config --libs x11)
t_PlayerMediaInfo_OBJC_FILES += Support/TestMedia.m ../../PlayerMediaInfo.m
t_PlayerMediaInfo_TOOL_LIBS += $(FFMPEG_LIBS)
t_RadioManager_OBJC_FILES += Support/TestMedia.m ../../RadioManager.m \
	../../RadioBrowser.m ../../RadioStation.m ../../PlayerAsync.m \
	../../StreamPlayer.m
t_RadioManager_TOOL_LIBS += -lgnustep-gui $(FFMPEG_LIBS)
t_MediaRemote_OBJC_FILES += ../../../MediaRemote/GSMediaPlayer2.m
t_StreamPlayer_OBJC_FILES += Support/TestMedia.m ../../StreamPlayer.m
t_StreamPlayer_TOOL_LIBS += $(FFMPEG_LIBS)
t_PodcastFeedParser_OBJC_FILES += ../../PlayerAsync.m
