# SPDX-License-Identifier: BSD-2-Clause
# Builds without GTK, GDK, GLib or Qt: only GNUstep base is needed at build time.
#
#   GTK 2 and 3:  GTK_PATH=$(PREFIX) GTK_MODULES=gtk-appmenu-do
#   GTK 4:        GIO_EXTRA_MODULES=$(PREFIX)/gio/modules
#   Qt 5 and 6:   QT_PLUGIN_PATH=$(PREFIX) QT_QPA_PLATFORMTHEME=gad

PREFIX ?= /System/Library/Libraries/appmenu-do
CC = clang
GS_FLAGS := $(shell gnustep-config --objc-flags)
GS_LIBS := $(shell gnustep-config --base-libs)

OBJDIR := obj
GTK_MODULE := $(OBJDIR)/modules/libgtk-appmenu-do.so
GTK4_CORE := $(OBJDIR)/lib/libgad-gtk4-core.so
GTK4_STUB := $(OBJDIR)/gio/libgad-gio.so
QT_CORE := $(OBJDIR)/lib/libgad-qt-core.so
# Qt 6 loads a platform plugin only for the exact minor version it runs, so one
# small file per minor version (6.2 up to 6.40) points at the single QT_CORE.
QT6_MINORS := $(shell i=2; while [ $$i -le 40 ]; do echo $$i; i=$$((i+1)); done)
QT_STUBS := $(OBJDIR)/platformthemes/libgad-qt5.so \
	$(foreach m,$(QT6_MINORS),$(OBJDIR)/platformthemes/libgad-qt6-$(m).so)
CORE_OBJS := $(OBJDIR)/core/node.o $(OBJDIR)/core/mainsync.o $(OBJDIR)/core/bridge.o
POLLER_OBJS := $(OBJDIR)/core/poller.o

# dlopen lives in libdl on Linux and in the C library on the BSDs
DL_LIBS := $(if $(filter Linux,$(shell uname -s)),-ldl,)

all: $(GTK_MODULE) $(GTK4_CORE) $(GTK4_STUB) $(QT_CORE) $(QT_STUBS)

$(OBJDIR)/%.o: %.c core/gad.h
	mkdir -p $(dir $@)
	$(CC) -std=gnu11 -Wall -Wextra -O2 -g -fPIC -Icore -c $< -o $@

# ARC: the bridge keeps connections in instance variables across run loop
# iterations, and a manually released autoreleased connection died right after
# it was made, so the module never saw Menu.app as reachable.
$(OBJDIR)/core/bridge.o: core/bridge.m core/gad.h
	mkdir -p $(dir $@)
	$(CC) $(filter-out -MMD -MP,$(GS_FLAGS)) -fobjc-arc -Wno-deprecated-declarations -Icore -c $< -o $@

$(GTK_MODULE): $(OBJDIR)/gtk/module.o $(CORE_OBJS)
	mkdir -p $(dir $@)
	$(CC) -shared -o $@ $^ $(GS_LIBS) $(DL_LIBS) -lpthread

# GTK 4 has no modules; GLib loads GIO modules from $GIO_EXTRA_MODULES instead.
# Every GLib program loads the stub, only a GTK 4 program loads the core.
$(GTK4_CORE): $(OBJDIR)/gtk4/gtk4.o $(POLLER_OBJS) $(CORE_OBJS)
	mkdir -p $(dir $@)
	$(CC) -shared -o $@ $^ $(GS_LIBS) $(DL_LIBS) -lpthread

$(GTK4_STUB): gtk4/gio-stub.c
	mkdir -p $(dir $@)
	$(CC) -std=gnu11 -Wall -Wextra -O2 -fPIC -shared -o $@ $< $(DL_LIBS)

$(QT_CORE): $(OBJDIR)/qt/qt.o $(POLLER_OBJS) $(CORE_OBJS)
	mkdir -p $(dir $@)
	$(CC) -shared -o $@ $^ $(GS_LIBS) $(DL_LIBS) -lpthread

# Qt finds the metadata of a plugin in an ELF note that has to come first, so
# the linker must not put a build id note before it.
$(OBJDIR)/platformthemes/libgad-qt6-%.so: qt/qtplugin.c qt/qt-metadata.h
	mkdir -p $(dir $@)
	$(CC) -std=gnu11 -Wall -Wextra -O2 -fPIC -shared -Wl,--build-id=none -DGAD_QT6_MINOR=$* -Iqt -o $@ $< $(DL_LIBS)

$(OBJDIR)/platformthemes/libgad-qt5.so: qt/qtplugin.c qt/qt-metadata.h
	mkdir -p $(dir $@)
	$(CC) -std=gnu11 -Wall -Wextra -O2 -fPIC -shared -Wl,--build-id=none -Iqt -o $@ $< $(DL_LIBS)

# qt/qt-metadata.h is generated by qt/tools/gen-qt-metadata.py and checked in, so
# building needs no Python; run `make metadata` after changing the script.
metadata:
	python3 qt/tools/gen-qt-metadata.py qt/qt-metadata.h

$(OBJDIR)/mock-menu-server: tests/mock-menu-server.m
	mkdir -p $(dir $@)
	$(CC) $(filter-out -MMD -MP,$(GS_FLAGS)) -o $@ $< $(GS_LIBS)

install: $(GTK_MODULE) $(GTK4_CORE) $(GTK4_STUB) $(QT_CORE) $(QT_STUBS)
	mkdir -p $(DESTDIR)$(PREFIX)/modules $(DESTDIR)$(PREFIX)/gio/modules \
		$(DESTDIR)$(PREFIX)/platformthemes $(DESTDIR)$(PREFIX)/lib
	install -m 755 $(GTK_MODULE) $(DESTDIR)$(PREFIX)/modules/
	install -m 755 $(GTK4_STUB) $(DESTDIR)$(PREFIX)/gio/modules/
	install -m 755 $(GTK4_CORE) $(QT_CORE) $(DESTDIR)$(PREFIX)/lib/
	install -m 755 $(QT_STUBS) $(DESTDIR)$(PREFIX)/platformthemes/

test: all $(OBJDIR)/mock-menu-server
	$(MAKE) -C tests/Unit
	cd tests/Unit && for t in obj/t_*; do [ -x $$t ] && [ -f $$t ] && ./$$t 2>&1; done | tee obj/unit.log | grep -E "Failed|Uncaught" ; \
	  ! grep -qE "Failed|Uncaught" obj/unit.log

check: test
	tests/smoke.sh

clean:
	rm -rf $(OBJDIR)
	-$(MAKE) -C tests/Unit clean

.PHONY: all install test check clean metadata
